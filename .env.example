# 端口号
# PORT=3000
# BIND_ADDRESS= # 留空监听所有网卡；桌面版会强制设为 127.0.0.1。
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com

# Turnstile 默认仅保护平台主站。仅当平台自有的其它 FQDN 也已加入 Cloudflare
# Turnstile hostname allowlist 时，才在此按逗号分隔追加；不要填写代理/OEM 域名。
# TURNSTILE_EXTRA_HOSTS=portal.example.com,login.example.com

# Docker Compose Quick Start 必填。分别执行 `openssl rand -hex 32`，
# 把输出填到等号后再启动；空值会让 Compose fail-closed。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 仅在启用对应可选服务时填写：
MYSQL_ROOT_PASSWORD=
CLICKHOUSE_PASSWORD=

# 安全模式：未设置/拼错会按 production 处理。本地源码/HTTP 开发必须显式 development。
# 公网生产须改为 production、启用 Secure Cookie，并填两把不同的随机密钥。
DEPLOYMENT_ENV=
SESSION_COOKIE_SECURE=
SESSION_SECRET=
CRYPTO_SECRET=

# 可登录 demoagent 默认不创建。仅本地 development 可显式启用；生产环境即使设为 true 也会拒绝。
# 启用时必须另行注入 16-20 字符的新口令，仓库不提供默认值或示例口令。
# MT_ENABLE_DEMO_AGENT_SEED=false
# MT_DEMO_AGENT_PASSWORD=


# 调试相关配置
# pprof 默认只监听回环；仅在有认证的隧道/反向代理保护时才改绑定地址。
# ENABLE_PPROF=false
# PPROF_BIND_ADDRESS=127.0.0.1
# PPROF_PORT=8005
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串（凭据由本地密钥管理/部署环境注入，模板不携带可复制密码）
# SQL_DSN=
# 日志数据库连接字符串（同样从部署环境注入）
# LOG_SQL_DSN=
# ClickHouse 日志库必须是单个直连端点；逗号多主机、alt_hosts、负载均衡到独立节点均不受支持。
# Billing projection 的持久去重依赖该单节点 MergeTree 的本地 token 状态。
# 升级仅为新 ClickHouse parts 添加 projection_key bloom index，不在启动时 MATERIALIZE 历史日志；查询会同时按 created_at 限定旧 parts。
# LOG_SQL_CLICKHOUSE_DEDUPLICATION_WINDOW=1000000 # Stable projection retry tokens retained by non-replicated MergeTree.
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60
# 仅用于首次升级 quota_data bucket_key 的停机迁移。不要写入常驻 Compose/部署配置。
# 先停止全部旧版本节点并备份数据库，只在一个新版本迁移节点临时设为 1；
# 该节点启动并完成唯一索引后删除变量，再启动其余新版本节点。
# QUOTA_DATA_BUCKET_MIGRATION_ACK_DRAINED=1


# 缓存相关配置
# Redis连接字符串（密码从部署环境注入）
# REDIS_CONN_STRING=
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新仅用于可重建的使用量/请求数统计；余额、令牌额度、订阅额度、收益与退款始终同步持久化。
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# RELAY_TIMEOUT=0 时，非流式上游请求仍会从建立连接到读完响应体施加总时限（默认 600 秒，最低 5 秒）。
# RELAY_NON_STREAM_TIMEOUT_SECONDS=600
# Relay 传输层连接/TLS 默认最多 10 秒，等待响应头默认最多 600 秒；三者最低均为 5 秒。
# RELAY_DIAL_TIMEOUT_SECONDS=10
# RELAY_TLS_HANDSHAKE_TIMEOUT_SECONDS=10
# RELAY_RESPONSE_HEADER_TIMEOUT_SECONDS=600
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认跟随 Go 标准库，设置为0表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300
# RELAY_COZE_POLL_TIMEOUT_SECONDS=210
# Xunfei WebSocket 从连接、发送到收完最终事件的总时限（默认 600 秒，最低 5 秒）。
# XUNFEI_UPSTREAM_TIMEOUT_SECONDS=600
# 非流式响应先完成持久化结算再回给客户端：1 MiB 内存后转入每实例 0700 临时目录中的 0600 文件。
# 普通同步响应先按内存额度准入、溢出磁盘前再升级到 256 MiB 最坏容量；全进程最多 64 个、合计 1 GiB。
# 容量或临时盘预检不足会在调用上游前返回 503。
# 上游已接受后若实际响应超过单请求硬上限，系统不会重试或退款；会记录关键错误并终止该响应，避免重复计费/重复生成。
# RELAY_RESPONSE_BUFFER_MEMORY_BYTES=1048576
# RELAY_RESPONSE_BUFFER_MAX_BYTES=268435456
# RELAY_RESPONSE_BUFFER_TOTAL_BYTES=1073741824
# RELAY_RESPONSE_BUFFER_MAX_CONCURRENT=64
# RELAY_RESPONSE_BUFFER_DISK_SAFETY_BYTES=16777216
# RELAY_RESPONSE_BUFFER_TEMP_DIR= # 留空使用系统临时目录；启动节点必须可写且有足够空间。
# RELAY_RESPONSE_BUFFER_STALE_SECONDS=86400 # 仅清理超过该年龄、匹配专用前缀且未持有进程锁的崩溃残留目录。
# TASK_SUBMISSION_IDEMPOTENCY_RETENTION_HOURS=168 # Task/MJ 幂等响应保留窗口；最小 24 小时，窗口后同 key 视为新请求。
# Provider JSON/error 响应（包括内嵌 base64/hex 的图片和语音）默认最多 16 MiB；超限后按“上游已接受”安全失败。
# 与上面的全进程并发准入门配合，默认最多同时解析 4 份受限 JSON，避免 256 MiB body + 解码字符串的堆内存放大。
# RELAY_UPSTREAM_JSON_MAX_BYTES=16777216 # 原始二进制语音不经过该 JSON 上限，直接流入有硬上限的磁盘 spool。
# Volcengine 流式 TTS：单 WebSocket message 默认 4 MiB，空闲 30 秒、整次响应 300 秒；客户端取消会主动关闭上游连接。
# RELAY_VOLCENGINE_TTS_WS_MAX_FRAME_BYTES=4194304
# RELAY_VOLCENGINE_TTS_WS_IDLE_SECONDS=30
# RELAY_VOLCENGINE_TTS_WS_TOTAL_SECONDS=300
# Ali 异步图片轮询总时限；轮询 sleep/HTTP 均绑定客户端请求 context。
# RELAY_ALI_IMAGE_POLL_TIMEOUT_SECONDS=210
# Provider 返回 URL 后的图片下载总时限；同时继承客户端取消信号。
# RELAY_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Realtime WebSocket 默认只允许同源网页；无 Origin 的 SDK/CLI 客户端不受影响。
# 可用英文逗号添加需要的精确 HTTP(S) Origin（不支持通配符）。
# WEBSOCKET_ALLOWED_ORIGINS=https://console.example.com,https://admin.example.com
# 仅当反代会改写 Host 时启用；同时必须在边界覆盖/清除客户端传入的 Forwarded 系列头。
# WEBSOCKET_TRUST_PROXY_HEADERS=false
# 紧急兼容开关：显式允许任意格式正确的浏览器 Origin；生产环境应优先使用上述 allowlist。
# WEBSOCKET_ALLOW_CROSS_ORIGIN=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话/加密密钥见文件顶部安全模式说明；禁止在 tracked 文件写字面值。

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
