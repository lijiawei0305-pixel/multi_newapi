            gap: 8,
            marginTop: 8,
          }}
        >
          {parsed.tokens.map((token) => (
            <Tag key={token} size='small'>
              {token}
            </Tag>
          ))}
        </div>
      )}
      {!parsed?.ok && (
        <Text type='danger' style={{ display: 'block', marginTop: 8 }}>
          {invalidText}
          {parsed?.invalidTokens && parsed.invalidTokens.length > 0
            ? `: ${parsed.invalidTokens.join(', ')}`
            : ''}
        </Text>
      )}
    </>
  );
}
