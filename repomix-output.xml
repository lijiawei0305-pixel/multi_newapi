          : null,
      image && imageOutputTokens > 0
          ? buildBillingPriceText(
              '图片输入价格：{{symbol}}{{total}} / 1M tokens',
              {
                symbol,
                usdAmount: imageRatioPrice,
                rate,
                amountKey: 'total',
              },
