        )
        : null,
    fileSearch && fileSearchCallCount > 0
        ? buildBillingText(
            '文件搜索：{{count}} / 1K * 单价 {{price}} * {{ratioType}} {{ratio}} = {{amount}}',
            {
              count: fileSearchCallCount,
              price: renderDisplayAmountFromUsd(fileSearchPrice),
