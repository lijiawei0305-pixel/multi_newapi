export default function HttpStatusCodeRulesInput(props) {
  const { Text } = Typography;
  const {
    label,
    field,
    placeholder,
    extraText,
    onChange,
    parsed,
    invalidText,
  } = props;

  return (
    <>
      <Form.Input
        label={label}
        placeholder={placeholder}
        extraText={extraText}
