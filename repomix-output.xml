        .filter(Boolean)
        .join('，'),
    textInputTokens > 0
        ? buildBillingText(
            '普通输入：{{tokens}} / 1M * 模型倍率 {{modelRatio}} * {{ratioType}} {{ratio}} = {{amount}}',
