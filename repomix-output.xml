                      ),
                    },
                    {
                      key: t('流量端口'),
                      value: details.container_config.traffic_port || 'N/A',
                    },
                    {
                      key: t('启动命令'),
                      value: (
                        <Text className='font-mono text-sm'>
                          {details.container_config.entrypoint
                            ? details.container_config.entrypoint.join(' ')
