          <TabPane
            key={key}
            itemKey={key}
            tab={
              <span className='flex items-center gap-2'>
                {getChannelIcon(option.value)}
                {option.label}
                <Tag
                  color={activeTypeKey === key ? 'red' : 'grey'}
