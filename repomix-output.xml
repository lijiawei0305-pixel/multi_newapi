		{"no-channel-param", "/sign-up?ref=poster"},
		{"empty-value", "/sign-up?channel="},
		{"no-query", "/sign-up"},
		{"bare-code-only", code}, // 裸渠道码不是 channel=... 形态
		{"malformed-escape", "/sign-up?channel=%zz"},
	}
	for _, c := range errCases {
