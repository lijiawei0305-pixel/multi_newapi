}

function FieldBlock({
  label,
  children,
}: {
  label: string
  children: ReactNode
}) {
  return (
    <div className='flex min-w-0 flex-col gap-2'>
      <span className='text-sm font-medium'>{label}</span>
      {children}
    </div>
  )
}
