	}
	if strings.Contains(info.RequestURLPath, "/v1/completions") || info.RelayMode == relayconstant.RelayModeCompletions {
		return info.ChannelBaseUrl + "/api/generate", nil
	}
	return info.ChannelBaseUrl + "/api/chat", nil
