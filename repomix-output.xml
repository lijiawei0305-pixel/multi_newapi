// newGroupHookTestApp 装配最小 App：sqlite(:memory:) + 原生 users 表(id,tenant_id) + tenant_groups 表。
func newGroupHookTestApp(t *testing.T) *App {
	t.Helper()
	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{TranslateError: true})
	if err != nil {
