  className?: string
): React.ReactNode {
  const Icon = ICON_MAP[iconName]
  if (!Icon) {
    // eslint-disable-next-line no-console
    console.warn(`Icon "${iconName}" not found in icon map`)
    return null
  }
  return <Icon className={className} />
}
