              </div>
            }
            className='border-0 shadow-sm'
          >
            <div className='space-y-4'>
              <Descriptions
                data={[
                  {
                    key: t('硬件类型'),
                    value: (
                      <div className='flex items-center gap-2'>
                        <Tag color='blue'>{details.brand_name}</Tag>
                        <Text strong>{details.hardware_name}</Text>
                      </div>
                    ),
