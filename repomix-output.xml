              color={activeTypeKey === 'all' ? 'red' : 'grey'}
              shape='circle'
            >
              {channelTypeCounts['all'] || 0}
            </Tag>
          </span>
        }
      />

      {CHANNEL_OPTIONS.filter((opt) =>
        availableTypeKeys.includes(String(opt.value)),
      ).map((option) => {
        const key = String(option.value);
