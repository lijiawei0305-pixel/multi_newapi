func TestCreditRejectsBadAmounts(t *testing.T) {
	ctx := context.Background()
	svc, _, _, _ := newSvc()
	cases := []CreditInput{
		{TenantID: 1, UserID: 1, CreditedUSD: -1, Source: SourceManual},
