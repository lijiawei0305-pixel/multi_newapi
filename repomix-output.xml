                  <Text>
                    {details.started_at
                      ? timestamp2string(details.started_at)
                      : 'N/A'}
                  </Text>
                </div>
                <div className='flex justify-between'>
                  <Text type='secondary'>{t('预计结束')}:</Text>
                  <Text>
                    {details.finished_at
