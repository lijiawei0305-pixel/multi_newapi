      visible={visible}
      onCancel={onCancel}
      footer={
        <div className='flex justify-between'>
          <Button
            icon={<IconRefresh />}
            onClick={handleRefresh}
            loading={loading || containersLoading}
            theme='borderless'
          >
            {t('刷新')}
          </Button>
          <Button onClick={onCancel}>{t('关闭')}</Button>
