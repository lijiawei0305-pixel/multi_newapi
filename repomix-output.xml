	principal *appctx.Principal
	err       error

	mu      sync.Mutex
	calls   int
	gotRaws []string
}

func (f *fakeAuthenticator) AuthenticateToken(_ context.Context, raw string) (*appctx.Principal, error) {
	if f.rec != nil {
		f.rec.add("auth")
	}
	f.mu.Lock()
	f.calls++
	f.gotRaws = append(f.gotRaws, raw)
	f.mu.Unlock()
	if f.err != nil {
		return nil, f.err
	}
	return f.principal, nil
}

