	p := principal()
	assertCode(t, e.CheckCall(context.Background(), p, CallContext{}), "")
	assertCode(t, e.CheckCall(context.Background(), p, CallContext{}), "")
	assertCode(t, e.CheckCall(context.Background(), p, CallContext{}), CodeRateLimited)
