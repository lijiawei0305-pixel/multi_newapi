		{"absolute-url", "https://aaa.wedreamhub.com/sign-up?channel=" + code},
		{"leading-question", "?channel=" + code},
		{"bare-query", "channel=" + code},
		{"extra-params", "/sign-up?channel=" + code + "&ref=poster"},
		{"surrounding-space", "  /sign-up?channel=" + code + "  "},
