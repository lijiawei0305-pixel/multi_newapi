# ──────────────────────────────────────────────────────────────────────
# Wedreamhub 多租户平台 — 单栈环境变量模板（脱敏占位，真实值不入库）
# 用法：cp deploy/.env.test.example /root/newapi-test/.env，填真实值后部署。
# ⚠️ 真实密钥向项目负责人索取；切勿提交真实 .env。
# 部署：docker compose -p newapi_test --env-file /root/newapi-test/.env \
#       -f deploy/docker-compose.test.yml up -d --build
# 注：DB/Redis 连接由 docker-compose.test.yml 组装，应用回环端口为 3100。
# ──────────────────────────────────────────────────────────────────────

# 主站内部管理端点共享密钥；任意强随机串，不再与退役 auth-service 共享。
# 生成示例：`openssl rand -hex 32`，把输出填到等号后；空值会让 Compose fail-closed。
MT_INTERNAL_SECRET=

# MySQL root 密码只存服务器 .env；首次初始化后若轮换，须先 ALTER USER 再同步此值。
# 生成示例：`openssl rand -hex 32`，空值会让 Compose fail-closed。
MYSQL_ROOT_PASSWORD=

# 应用专用 MySQL 用户；默认用户名 newapi，只授予 new-api-test schema 权限。
# 对已有数据卷，mysql-access-bootstrap 会在 app 启动前幂等创建/轮换该用户。
MYSQL_APP_USER=newapi
MYSQL_APP_PASSWORD=

# Redis 关闭匿名 default 用户，应用与 ops 使用同一个显式 ACL 用户。
# 密码须为 64–128 位十六进制；可用 `openssl rand -hex 32` 生成。
REDIS_APP_USER=newapi
REDIS_PASSWORD=

# 基础镜像默认已锁定到现网验证 digest。只有完成隔离 restore/升级/回滚演练后才覆盖。
# MYSQL_IMAGE=mysql:8.4.x@sha256:<approved-manifest-digest>
# REDIS_IMAGE=redis:8.8.0@sha256:<approved-manifest-digest>

# 会话签名与缓存/HMAC 派生必须使用两把不同的强随机密钥。
# 可分别执行 `openssl rand -hex 32` 生成并填入；生产启动会拒绝空值或复用。
SESSION_SECRET=
CRYPTO_SECRET=

# 配对备份的异地加密复制。生产应设 REQUIRED=1；rclone remote 必须属于
# 独立账号/区域，并在存储端启用 Object Lock/不可变保留与生命周期告警。
BACKUP_OFFSITE_REQUIRED=1
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_AGE_RECIPIENT=

# 上游模型渠道（relay 自测用；填能分发对应模型的上游 base_url + key）
UPSTREAM_BASE_URL=https://your-upstream-host/v1
UPSTREAM_API_KEY=

# 微信/支付宝异步通知的公网基址；支付 SDK 已在主站进程内运行。
MT_PAY_NOTIFY_BASE=https://your-domain.example.com

# 7c 风控：调用前 RPM 限流默认阈值（每分钟每用户，0=关闭；compose 已默认 60，可在此覆盖）
# RISK_DEFAULT_RPM=60

# ── 可选性能调优（对照 doc/tokease-config-compare.md；默认多走代码/compose，勿为对标对方乱开）──
# Redis 已启用时 main 会打开内存渠道缓存；一般无需再设 MEMORY_CACHE_ENABLED。
# SYNC_FREQUENCY=60
# CHANNEL_UPDATE_FREQUENCY=30
# RELAY_MAX_IDLE_CONNS=500
# RELAY_MAX_IDLE_CONNS_PER_HOST=100
# RELAY_DIAL_TIMEOUT_SECONDS=10
# RELAY_RESPONSE_HEADER_TIMEOUT_SECONDS=600
# STREAMING_TIMEOUT=300
# 生产 compose 已写死 BATCH_UPDATE_ENABLED=false（统计批量写；资金路径始终同步）。
# 无持久 outbox 前不要改为 true。智能选路见 doc/smart-router-design.md（默认关闭，实现后另加开关）。

# 微信 Native 与支付宝电脑网站支付凭据在主站「系统设置 → 集成 → 支付」中维护，
# 由现有 options 配置写入数据库；必须通过数据库访问控制、备份权限和密钥轮换保护。
# 不再通过 auth-service、AUTH_* 环境变量或额外容器配置。上线前分别执行管理页连接验证，
# 再用 `/health/ready` 验证主站的 DB/Redis 依赖；健康检查不依赖任何辅助支付端口。
