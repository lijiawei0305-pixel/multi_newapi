# ──────────────────────────────────────────────────────────────────────
# Wedreamhub 多租户平台 — 测试栈环境变量模板（脱敏占位，真实值不入库）
# 用法：cp deploy/.env.test.example /root/newapi-test/.env，填真实值后部署。
# ⚠️ 真实密钥向项目负责人索取；切勿提交真实 .env。
# 部署：docker compose -p newapi_test --env-file /root/newapi-test/.env \
#       -f deploy/docker-compose.test.yml up -d --build
# 注：DB/Redis 连接在 docker-compose.test.yml 内置（测试栈隔离，端口 3100）。
# ──────────────────────────────────────────────────────────────────────

# 内网入账共享密钥（主站 ↔ auth-service 必须同值；任意强随机串）
MT_INTERNAL_SECRET=change-me-strong-random

# auth-service mock 签名密钥（mock 模式 HMAC 签名/验签；任意强随机串）
AUTH_SIGN_SECRET=change-me-strong-random

# new-api 会话密钥（session；任意强随机串）
SESSION_SECRET=change-me-strong-random

# 上游模型渠道（relay 自测用；填能分发对应模型的上游 base_url + key）
UPSTREAM_BASE_URL=https://your-upstream-host/v1
UPSTREAM_API_KEY=sk-your-upstream-key

# auth-service 确认页/二维码公网基址（经 nginx ^~ /auth/ 反代回此服务）
AUTH_PUBLIC_BASE_URL=https://your-domain.example.com

# 7c 风控：调用前 RPM 限流默认阈值（每分钟每用户，0=关闭；compose 已默认 60，可在此覆盖）
# RISK_DEFAULT_RPM=60

# ──────────────────────────────────────────────────────────────────────
# 真实微信/支付宝支付（mock:false）—— 默认全部留空走 mock。接真实支付时取消注释并填值。
# ⚠️ 私钥/证书为文件路径：把 PEM 文件放到服务器（如 /root/newapi-test/secrets/，chmod 600），
#    并在 docker-compose.test.yml 给 auth-service 挂载该目录（见该文件注释）。真实凭据不入库。
# ──────────────────────────────────────────────────────────────────────
# AUTH_MOCK=false
# 异步回调公网基址（回填 notify_url；微信→<base>/pay/wxpay/notify，支付宝→<base>/auth/alipay/notify）
# MT_PAY_NOTIFY_BASE=https://your-domain.example.com
# 美元→人民币汇率（auth-service 与主站须同值；主站经 USDExchangeRate）
# AUTH_USD_TO_CNY_RATE=7.3
#
# 微信支付（Native 扫码）
# AUTH_WXPAY_APP_ID=wx_xxx
# AUTH_WXPAY_MCH_ID=160xxxxxxx
# AUTH_WXPAY_APIV3_KEY=your-32-char-apiv3-key
# AUTH_WXPAY_CERT_SERIAL=your-cert-serial-no
# AUTH_WXPAY_PRIVATE_KEY_PATH=/etc/auth-service/secrets/wx_apiclient_key.pem
#
# 支付宝（电脑网站支付）
# AUTH_ALIPAY_APP_ID=2021xxxxxxxxxxxx
# AUTH_ALIPAY_PRIVATE_KEY_PATH=/etc/auth-service/secrets/alipay_app_private_key.pem
# AUTH_ALIPAY_PUBLIC_KEY_PATH=/etc/auth-service/secrets/alipay_public_key.pem
# AUTH_ALIPAY_SELLER_ID=2088xxxxxxxxxxxx
# AUTH_ALIPAY_RETURN_URL=https://your-domain.example.com/order/status
# AUTH_ALIPAY_SANDBOX=false
